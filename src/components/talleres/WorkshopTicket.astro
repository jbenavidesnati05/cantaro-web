---
// Tarjeta tipo "ticket" de un taller.
import Icon from '@/components/brand/Icon.astro';
import { formatCOP, formatDateParts, formatTime } from '@/lib/format';
import { waLink } from '@/lib/whatsapp';
import { business } from '@/data/business';
import type { Workshop } from '@/lib/catalog';

interface Props {
  workshop: Workshop;
  headingLevel?: 'h2' | 'h3';
}
const { workshop: w, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
const d = formatDateParts(w.date);
const price = formatCOP(w.priceCOP);
const hours = w.durationMin ? `${Math.floor(w.durationMin / 60)} h${w.durationMin % 60 ? ` ${w.durationMin % 60} min` : ''}` : null;
const wa = waLink(`¡Hola, Cántaro! Quiero reservar un cupo para "${w.title}" del ${d.full}.`);
---

<article class="ticket reveal relative grid overflow-hidden rounded-[2rem] bg-paper shadow-[0_24px_50px_-30px_rgb(91_58_33/0.55)] ring-1 ring-bark-800/5 sm:grid-cols-[11rem_1fr]">
  <!-- Talón con la fecha -->
  <div class="stub relative flex items-center justify-between gap-4 bg-clay-600 px-6 py-5 text-cream-50 sm:flex-col sm:justify-center sm:py-8 sm:text-center">
    <div class="leading-none">
      <p class="text-sm tracking-[0.2em] text-cream-50/80 uppercase">{d.month}</p>
      <p class="font-display text-7xl font-medium text-cream-50 sm:text-8xl">{d.day}</p>
    </div>
    <p class="text-right text-sm sm:text-center">
      <span class="capitalize">{d.weekday}</span>
      {w.time && <><br />{formatTime(w.time)}</>}
    </p>
  </div>

  <div class="p-6 sm:p-8">
    {w.level && <p class="text-sm font-semibold tracking-[0.15em] text-clay-600 uppercase">{w.level}</p>}
    <H class="mt-2 text-3xl leading-tight font-medium">{w.title}</H>
    <p class="mt-3 text-bark-600">{w.description}</p>

    <ul class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-[0.95rem] text-bark-800">
      {hours && <li class="flex items-center gap-1.5"><Icon name="clock" size={18} class="text-clay-600" />{hours}</li>}
      {w.spots && <li class="flex items-center gap-1.5"><Icon name="users" size={18} class="text-clay-600" />{w.spots} cupos</li>}
      {price && <li class="flex items-center gap-1.5"><Icon name="ticket" size={18} class="text-clay-600" />{price}</li>}
    </ul>

    {
      w.includes.length > 0 && (
        <p class="mt-4 text-[0.95rem] text-bark-600">
          <span class="font-medium text-bark-800">Incluye:</span> {w.includes.join(' · ')}
        </p>
      )
    }

    {/* WhatsApp si existe; si no, correo como respaldo */}
    <a
      href={wa ?? `mailto:${business.email}?subject=${encodeURIComponent(`Reserva: ${w.title} (${d.full})`)}`}
      target={wa ? '_blank' : undefined}
      rel={wa ? 'noopener' : undefined}
      class="mt-6 inline-flex min-h-12 items-center gap-2 rounded-full bg-olive-900 px-6 font-semibold text-cream-50 transition hover:bg-olive-700"
    >
      Reservar mi cupo
      <Icon name={wa ? 'arrow-up-right' : 'mail'} size={18} />
    </a>
  </div>
</article>

<style>
  /* Muescas del ticket */
  .stub::before,
  .stub::after {
    content: '';
    position: absolute;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 9999px;
    background: var(--ticket-bg, var(--color-cream-50));
  }
  .stub::before {
    left: -0.875rem;
    bottom: -0.875rem;
  }
  .stub::after {
    right: -0.875rem;
    bottom: -0.875rem;
  }
  @media (min-width: 40rem) {
    .stub::before {
      left: auto;
      right: -0.875rem;
      top: -0.875rem;
      bottom: auto;
    }
    .stub {
      border-right: 2px dashed rgb(255 253 248 / 0.5);
    }
  }
</style>
