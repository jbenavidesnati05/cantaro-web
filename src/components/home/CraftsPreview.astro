---
import Icon from '@/components/brand/Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { CRAFT_CATEGORIES } from '@/lib/catalog';

const tones = [
  'bg-clay-500/12 text-clay-600',
  'bg-leaf-500/15 text-olive-700',
  'bg-clay-300/35 text-bark-800',
  'bg-olive-900/90 text-cream-50',
  'bg-cream-100 text-clay-600',
];
---

<section class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28" aria-labelledby="artesanias-title">
  <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
    <SectionHeading
      id="artesanias-title"
      eyebrow="Tienda artesanal"
      title="Hecho con las manos, para tu casa"
      highlight="las manos"
      intro="Piezas pequeñas, hechas con calma y en pocas cantidades. Las encuentras en el local, junto a tu café."
    />
    <a
      href="/artesanias"
      class="reveal group inline-flex min-h-12 shrink-0 items-center gap-2 self-start rounded-full px-6 font-semibold text-bark-800 ring-1 ring-bark-800/20 transition hover:bg-paper md:self-auto"
    >
      Ver artesanías
      <Icon name="arrow-right" size={18} class="transition-transform group-hover:translate-x-1" />
    </a>
  </div>

  <ul class="no-scrollbar -mx-4 mt-12 flex snap-x snap-mandatory scroll-px-4 gap-4 overflow-x-auto px-4 pb-4 md:mx-0 md:grid md:grid-cols-5 md:overflow-visible md:px-0">
    {
      CRAFT_CATEGORIES.map((c, i) => (
        <li class="reveal w-[72%] shrink-0 snap-start sm:w-[45%] md:w-auto">
          <a
            href={`/artesanias#${c.id}`}
            class="group flex h-full flex-col rounded-[2rem] bg-paper p-6 shadow-[0_18px_40px_-28px_rgb(91_58_33/0.5)] ring-1 ring-bark-800/5 transition duration-300 hover:-translate-y-1.5 hover:rotate-[0.6deg]"
          >
            <span class:list={['blob grid size-20 place-items-center [animation-duration:20s]', tones[i % tones.length]]}>
              <Icon name={c.icon} size={34} />
            </span>
            <h3 class="mt-6 text-2xl font-medium">{c.name}</h3>
            <p class="mt-2 text-bark-600">{c.blurb}</p>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .no-scrollbar {
    scrollbar-width: none;
  }
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
</style>
