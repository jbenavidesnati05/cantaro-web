---
const words = ['Café', 'Velas', 'Cerámica', 'Aromáticas', 'Textiles', 'Talleres', 'Tortas', 'Esencias'];
---

<section class="overflow-hidden bg-olive-900 py-5 text-cream-50 sm:py-7" aria-label="Lo que encuentras en Cántaro">
  <p class="sr-only">{words.join(', ')}</p>
  <div class="marquee flex w-max" aria-hidden="true">
    {
      [0, 1].map(() => (
        <ul class="flex shrink-0 items-center">
          {words.map((w) => (
            <li class="flex items-center font-display text-3xl italic sm:text-5xl">
              <span class="px-6 sm:px-10">{w}</span>
              <svg width="22" height="22" viewBox="0 0 24 24" class="text-clay-300">
                <path d="M12 2c-4 6-4 14 0 20 4-6 4-14 0-20z" fill="currentColor" />
              </svg>
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</section>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .marquee {
      animation: marquee 38s linear infinite;
    }
    .marquee:hover {
      animation-play-state: paused;
    }
  }
</style>
