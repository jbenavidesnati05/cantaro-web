---
import { Image } from 'astro:assets';
import Icon from '@/components/brand/Icon.astro';
import Beans from '@/components/brand/Beans.astro';
import { business } from '@/data/business';
import { formatDateParts } from '@/lib/format';
import type { Workshop } from '@/lib/catalog';
import latte from '@/assets/photos/latte.jpg';
import vela from '@/assets/scenes/vela.jpg';
import tazaHojas from '@/assets/scenes/taza-hojas.jpg';

interface Props {
  nextWorkshop: Workshop | undefined;
}
const { nextWorkshop } = Astro.props;
const wsDate = nextWorkshop ? formatDateParts(nextWorkshop.date) : null;
---

<section class="mesh-warm grain relative overflow-hidden pt-28 pb-20 sm:pt-36 lg:min-h-[100dvh] lg:pb-28" aria-labelledby="hero-title">
  <Beans />

  <div class="relative mx-auto grid max-w-6xl items-center gap-14 px-4 sm:px-6 lg:grid-cols-[1.1fr_0.9fr]">
    <div>
      <p class="hero-in inline-flex items-center gap-2 rounded-full bg-paper/70 px-3.5 py-1.5 text-sm font-medium text-olive-900 ring-1 ring-olive-900/10 backdrop-blur">
        <Icon name="map-pin" size={16} class="text-clay-600" />
        {business.address.locality}, {business.address.region}
      </p>

      <h1 id="hero-title" class="mt-6 text-hero leading-[0.92] font-medium tracking-tight" data-split>
        Un espacio de café y <em class="brush-underline font-normal text-clay-600">creación</em>
      </h1>

      <p class="hero-in mt-8 max-w-xl text-lg leading-relaxed text-bark-600 sm:text-xl [--d:700ms]">
        Café colombiano, objetos hechos a mano y talleres para aprender con las manos, en el corazón del Valle de
        Sibundoy. Llega, pide algo rico y quédate un rato.
      </p>

      <div class="hero-in mt-8 flex flex-col gap-3 sm:flex-row [--d:850ms]">
        <a
          href="/menu"
          class="group relative inline-flex min-h-13 items-center justify-center gap-2 overflow-hidden rounded-full bg-olive-900 px-7 text-lg font-semibold text-cream-50 shadow-[0_12px_30px_-12px_rgb(47_62_15/0.7)] transition hover:bg-olive-700"
        >
          <span class="absolute inset-0 -translate-x-full bg-gradient-to-r from-transparent via-white/15 to-transparent transition-transform duration-700 group-hover:translate-x-full"></span>
          Ver la carta
          <Icon name="arrow-right" size={20} class="transition-transform group-hover:translate-x-1" />
        </a>
        <a
          href="/talleres"
          class="inline-flex min-h-13 items-center justify-center gap-2 rounded-full bg-paper/80 px-7 text-lg font-semibold text-bark-800 ring-1 ring-bark-800/15 backdrop-blur transition hover:bg-paper"
        >
          <Icon name="palette" size={20} class="text-clay-600" />
          Próximos talleres
        </a>
      </div>

      <ul class="hero-in mt-10 flex flex-wrap gap-x-6 gap-y-3 text-bark-600 [--d:1000ms]">
        <li class="flex items-center gap-2"><Icon name="coffee" class="text-clay-600" /> Café y postres</li>
        <li class="flex items-center gap-2"><Icon name="amphora" class="text-clay-600" /> Artesanías</li>
        <li class="flex items-center gap-2"><Icon name="palette" class="text-clay-600" /> Talleres</li>
      </ul>
    </div>

    <!-- Collage: foto en arco + escenas de marca -->
    <div class="relative mx-auto w-full max-w-[28rem] lg:max-w-none">
      <div class="blob absolute -inset-6 bg-clay-300/45" aria-hidden="true"></div>

      <div class="hero-pop relative ml-auto aspect-[4/5] w-[78%] overflow-hidden rounded-t-full rounded-b-[2.5rem] shadow-[0_40px_60px_-30px_rgb(91_58_33/0.6)] ring-8 ring-paper/70" data-parallax="-0.06">
        <Image src={latte} alt="Latte con arte en la espuma sobre una mesa de madera" widths={[360, 560, 760]} sizes="(min-width: 1024px) 28rem, 78vw" loading="eager" fetchpriority="high" class="size-full object-cover" />
      </div>

      <div class="hero-pop absolute bottom-[6%] left-0 aspect-square w-[42%] overflow-hidden rounded-full shadow-xl ring-8 ring-paper [--d:250ms]" data-parallax="0.08">
        <Image src={tazaHojas} alt="Taza de cerámica pintada con hojas" widths={[200, 360]} sizes="12rem" loading="eager" class="size-full object-cover" />
      </div>

      <div class="hero-pop absolute top-[4%] left-[2%] aspect-[3/4] w-[26%] overflow-hidden rounded-[1.5rem] shadow-lg ring-4 ring-paper [--d:400ms]" data-parallax="0.14">
        <Image src={vela} alt="Vela artesanal con lavanda" widths={[160, 280]} sizes="8rem" loading="eager" class="size-full object-cover" />
      </div>

      <div class="float absolute top-[8%] -right-2 flex items-center gap-2 rounded-2xl bg-paper/90 px-3.5 py-2.5 text-sm font-semibold shadow-lg ring-1 ring-bark-800/5 backdrop-blur [animation-delay:-2s] sm:-right-6">
        <span class="grid size-8 place-items-center rounded-full bg-clay-500/15 text-clay-600"><Icon name="hand-heart" size={18} /></span>
        Hecho a mano
      </div>

      {
        wsDate && nextWorkshop && (
          <a
            href="/talleres"
            class="float absolute -right-2 bottom-[2%] flex items-center gap-3 rounded-2xl bg-olive-900 px-4 py-3 text-cream-50 shadow-xl transition hover:bg-olive-700 [animation-delay:-4s] sm:-right-6"
          >
            <span class="text-center leading-none">
              <span class="block font-display text-3xl">{wsDate.day}</span>
              <span class="block text-xs tracking-widest text-clay-300 uppercase">{wsDate.month}</span>
            </span>
            <span class="max-w-[9rem] text-sm leading-snug">
              <span class="block text-xs text-cream-100/70">Próximo taller</span>
              {nextWorkshop.title}
            </span>
          </a>
        )
      }
    </div>
  </div>

  <a href="#descubre" class="absolute bottom-6 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-2 text-sm text-bark-600 lg:flex" aria-label="Bajar a descubrir Cántaro">
    <span class="scroll-cue h-10 w-6 rounded-full border-2 border-bark-600/40"></span>
  </a>
</section>

<style>
  .scroll-cue {
    position: relative;
  }
  .scroll-cue::after {
    content: '';
    position: absolute;
    top: 6px;
    left: 50%;
    width: 4px;
    height: 8px;
    margin-left: -2px;
    border-radius: 2px;
    background: var(--color-clay-500);
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-in {
      animation: hero-in 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both;
      animation-delay: var(--d, 0ms);
    }
    .hero-pop {
      animation: hero-pop 1.1s cubic-bezier(0.2, 0.9, 0.25, 1.15) both;
      animation-delay: calc(300ms + var(--d, 0ms));
    }
    .float {
      animation: float 6s ease-in-out infinite;
    }
    .scroll-cue::after {
      animation: cue 1.8s ease-in-out infinite;
    }
  }
  @keyframes hero-in {
    from { opacity: 0; transform: translateY(24px); }
    to { opacity: 1; transform: none; }
  }
  @keyframes hero-pop {
    from { opacity: 0; transform: scale(0.7) rotate(-4deg); }
    to { opacity: 1; transform: none; }
  }
  @keyframes cue {
    0% { transform: translateY(0); opacity: 1; }
    80% { transform: translateY(14px); opacity: 0; }
    100% { opacity: 0; }
  }
</style>
