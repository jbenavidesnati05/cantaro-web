---
// Encabezado de páginas internas (artesanías, talleres, contacto), con imagen opcional en arco.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Beans from '@/components/brand/Beans.astro';

interface Props {
  eyebrow: string;
  title: string;
  highlight?: string;
  intro?: string;
  image?: ImageMetadata;
  imageAlt?: string;
}
const { eyebrow, title, highlight, intro, image, imageAlt = '' } = Astro.props;
const parts = highlight && title.includes(highlight) ? title.split(highlight) : [title];
---

<section class="mesh-warm grain relative overflow-hidden pt-32 pb-14 sm:pt-40 sm:pb-20">
  <div class="blob pointer-events-none absolute -top-16 -right-20 size-72 bg-clay-300/40" aria-hidden="true"></div>
  <Beans
    beans={[
      { top: '20%', left: '3%', size: 26, r: 30, blur: 1, opacity: 0.5, t: 9 },
      { top: '75%', right: '45%', size: 36, r: -50, blur: 2, opacity: 0.4, t: 11 },
    ]}
  />
  <div class:list={['relative mx-auto grid max-w-6xl items-center gap-10 px-4 sm:px-6', image && 'lg:grid-cols-[1.2fr_0.8fr]']}>
    <div>
      <p class="hero-in text-sm font-semibold tracking-[0.18em] text-clay-600 uppercase">{eyebrow}</p>
      <h1 class="hero-in mt-4 max-w-4xl text-[clamp(2.75rem,1.8rem+4.5vw,5.5rem)] leading-[0.98] font-medium tracking-tight [--d:100ms]">
        {parts[0]}
        {
          parts.length > 1 && (
            <>
              <em class="brush-underline font-normal text-clay-600">{highlight}</em>
              {parts[1]}
            </>
          )
        }
      </h1>
      {intro && <p class="hero-in mt-6 max-w-2xl text-lg leading-relaxed text-bark-600 sm:text-xl [--d:200ms]">{intro}</p>}
      <div class="hero-in [--d:300ms]"><slot /></div>
    </div>
    {
      image && (
        <div class="hero-in relative mx-auto hidden w-full max-w-sm lg:block [--d:250ms]">
          <div class="blob absolute -inset-5 bg-clay-300/45" aria-hidden="true" />
          <Image
            src={image}
            alt={imageAlt}
            widths={[400, 700]}
            sizes="24rem"
            loading="eager"
            class="relative aspect-[4/5] w-full rounded-t-full rounded-b-[2.5rem] object-cover shadow-[0_40px_60px_-30px_rgb(91_58_33/0.6)] ring-8 ring-paper/70"
          />
        </div>
      )
    }
  </div>
</section>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .hero-in {
      animation: hero-in 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both;
      animation-delay: var(--d, 0ms);
    }
  }
  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
