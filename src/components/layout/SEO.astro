---
import { business } from '@/data/business';

interface Props {
  title?: string;
  description?: string;
  /** Ruta absoluta o relativa a la raíz para og:image. */
  image?: string;
  noindex?: boolean;
}

const { title, description = business.description, image = '/brand/og.jpg', noindex = false } = Astro.props;

const fullTitle = title ? `${title} · ${business.shortName}` : `${business.shortName} · ${business.tagline}`;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site);
const ogImage = new URL(image, Astro.site);
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}

<meta property="og:type" content="website" />
<meta property="og:locale" content="es_CO" />
<meta property="og:site_name" content={business.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
