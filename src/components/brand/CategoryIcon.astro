---
// Ícono de categoría del menú (alias de Icon, con café como respaldo).
import Icon from './Icon.astro';

interface Props {
  name?: string | undefined;
  size?: number;
  class?: string;
}
const { name, size = 20, class: className = '' } = Astro.props;
---

<Icon name={name ?? 'coffee'} size={size} class={className} />
