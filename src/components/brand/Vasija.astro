---
// Ilustración propia: cántaro de barro con vapor y hojas (inspirada en el logo, no lo reemplaza).
interface Props {
  class?: string;
  steam?: boolean;
}
const { class: className = '', steam = true } = Astro.props;
---

<svg viewBox="0 0 320 360" class={className} role="img" aria-label="Ilustración de un cántaro de barro con vapor">
  <defs>
    <linearGradient id="vasija-body" x1="0" x2="1" y1="0" y2="1">
      <stop offset="0" stop-color="#E9A27A" />
      <stop offset=".45" stop-color="#D2652A" />
      <stop offset="1" stop-color="#9E4A1C" />
    </linearGradient>
    <linearGradient id="vasija-band" x1="0" x2="1">
      <stop offset="0" stop-color="#F8EEDD" />
      <stop offset="1" stop-color="#F1E2C8" />
    </linearGradient>
  </defs>

  {
    steam && (
      <g fill="none" stroke="#D2652A" stroke-linecap="round" stroke-width="7" class="steam">
        <path d="M150 112c-18-22 14-34 0-58s16-30 6-48" />
        <path d="M182 108c-14-18 12-28 0-48s12-24 4-38" opacity=".7" />
      </g>
    )
  }

  <!-- asa -->
  <path d="M92 168c-46-6-58 52-24 84 12 11 26 18 40 22" fill="none" stroke="#9E4A1C" stroke-width="16" stroke-linecap="round" />
  <!-- cuerpo -->
  <path
    d="M108 132h112c8 0 12 6 10 13l-6 20c34 28 46 64 38 100-10 46-52 72-98 72s-88-26-98-72c-8-36 4-72 38-100l-6-20c-2-7 2-13 10-13z"
    fill="url(#vasija-body)"
  />
  <!-- boca -->
  <ellipse cx="164" cy="134" rx="60" ry="14" fill="#5B3A21" />
  <ellipse cx="164" cy="131" rx="50" ry="9" fill="#7A5A40" />
  <!-- banda decorativa -->
  <path d="M80 236c50 16 118 16 168 0v34c-50 16-118 16-168 0z" fill="url(#vasija-band)" opacity=".95" />
  <g fill="#D2652A">
    <path d="M104 254c6-8 14-8 18 0-6 8-14 8-18 0z" />
    <path d="M140 258c6-8 14-8 18 0-6 8-14 8-18 0z" />
    <path d="M176 258c6-8 14-8 18 0-6 8-14 8-18 0z" />
    <path d="M212 254c6-8 14-8 18 0-6 8-14 8-18 0z" />
  </g>
  <g fill="#6E9E2E">
    <circle cx="131" cy="257" r="2.5" /><circle cx="167" cy="259" r="2.5" /><circle cx="203" cy="257" r="2.5" />
  </g>
  <!-- brillo -->
  <path d="M110 190c-14 18-20 38-18 58" fill="none" stroke="#FFFDF8" stroke-width="8" stroke-linecap="round" opacity=".35" />
  <!-- hojas -->
  <g>
    <path d="M232 168c28-30 62-26 72-22-6 28-36 48-72 22z" fill="#6E9E2E" />
    <path d="M236 166c20-10 40-14 62-18" stroke="#4A5D1E" stroke-width="2" fill="none" />
    <path d="M60 318c20-30 56-34 70-30-8 26-40 46-70 30z" fill="#6E9E2E" />
    <path d="M62 316c22-12 44-20 66-26" stroke="#4A5D1E" stroke-width="2" fill="none" />
  </g>
</svg>

<style>
  .steam path {
    stroke-dasharray: 120;
    stroke-dashoffset: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .steam path {
      animation: steam 3.6s ease-in-out infinite;
    }
    .steam path:nth-child(2) {
      animation-delay: 1.4s;
    }
  }
</style>
