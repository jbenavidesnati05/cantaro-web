---
import PageLayout from '@/layouts/PageLayout.astro';
import Hero from '@/components/home/Hero.astro';
import Marquee from '@/components/home/Marquee.astro';
import PourStory from '@/components/home/PourStory.astro';
import FeaturedMenu from '@/components/home/FeaturedMenu.astro';
import Story from '@/components/home/Story.astro';
import CraftsPreview from '@/components/home/CraftsPreview.astro';
import WorkshopsSection from '@/components/home/WorkshopsSection.astro';
import Faq from '@/components/home/Faq.astro';
import Visit from '@/components/home/Visit.astro';
import { business } from '@/data/business';
import { getUpcomingWorkshops } from '@/lib/catalog';
import { DAY_ORDER } from '@/lib/schedule';

const workshops = await getUpcomingWorkshops();

// JSON-LD CafeOrCoffeeShop (se omiten los campos null).
const schemaDays: Record<string, string> = {
  mon: 'Monday', tue: 'Tuesday', wed: 'Wednesday', thu: 'Thursday', fri: 'Friday', sat: 'Saturday', sun: 'Sunday',
};
const hours = business.hours;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CafeOrCoffeeShop',
  name: business.name,
  description: business.description,
  url: business.url,
  email: business.email,
  image: new URL('/brand/og.jpg', business.url).href,
  logo: new URL('/brand/icon-512.png', business.url).href,
  hasMenu: new URL('/menu', business.url).href,
  servesCuisine: ['Café', 'Postres'],
  ...(business.whatsapp && { telephone: `+${business.whatsapp}` }),
  address: {
    '@type': 'PostalAddress',
    ...(business.address.street && { streetAddress: business.address.street }),
    addressLocality: business.address.locality,
    addressRegion: business.address.region,
    addressCountry: business.address.country,
  },
  ...(business.geo && { geo: { '@type': 'GeoCoordinates', latitude: business.geo.lat, longitude: business.geo.lng } }),
  ...(hours && {
    openingHoursSpecification: DAY_ORDER.filter((d) => hours[d]).map((d) => ({
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: schemaDays[d],
      opens: hours[d]!.open,
      closes: hours[d]!.close,
    })),
  }),
  sameAs: Object.values(business.social).filter(Boolean),
};
---

<PageLayout loader>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <Hero nextWorkshop={workshops[0]} />
  <Marquee />
  <PourStory />
  <FeaturedMenu />
  <Story />
  <CraftsPreview />
  <WorkshopsSection workshops={workshops} />
  <Faq />
  <Visit />
</PageLayout>

<script>
  import '@/scripts/effects';
</script>
