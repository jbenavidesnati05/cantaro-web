---
// Portada provisional (Fase 1). La landing completa se construye en la Fase 3.
import BaseLayout from '@/layouts/BaseLayout.astro';
import Logo from '@/components/brand/Logo.astro';
import { business } from '@/data/business';
import { getMenu, showDemo } from '@/lib/menu';

const menu = await getMenu();
const count = menu.reduce((n, s) => n + s.products.length, 0);
---

<BaseLayout>
  <main id="contenido" class="grain grid min-h-dvh place-items-center bg-cream-50 px-4 py-16 text-center">
    <div class="max-w-xl">
      <Logo size={160} class="mx-auto shadow-lg" />
      <h1 class="mt-8 text-display leading-tight">
        Un espacio de <em class="text-clay-600">café</em> y creación
      </h1>
      <p class="mt-4 text-lg text-bark-600">{business.address.locality}, {business.address.region}</p>
      <p class="mt-8 text-sm text-bark-600">
        Base del proyecto lista · {menu.length} categorías · {count} productos {showDemo && '(demo)'}
      </p>
    </div>
  </main>
</BaseLayout>
