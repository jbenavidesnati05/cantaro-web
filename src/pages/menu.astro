---
/**
 * /menu — Carta digital del QR. RUTA PERMANENTE: no renombrar ni mover.
 * Solo lectura: sin carrito, sin botones de pedir, sin formularios.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Logo from '@/components/brand/Logo.astro';
import SocialIcon from '@/components/brand/SocialIcon.astro';
import CategoryNav from '@/components/menu/CategoryNav.astro';
import CategorySection from '@/components/menu/CategorySection.astro';
import TodayHours from '@/components/layout/TodayHours.astro';
import { business } from '@/data/business';
import { getMenu } from '@/lib/menu';

const sections = await getMenu();
const hasDemo = sections.some((s) => s.products.some((p) => p.demo));

const updatedAt = new Intl.DateTimeFormat('es-CO', {
  timeZone: business.timezone,
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(new Date());

const socials = (['instagram', 'facebook', 'tiktok'] as const)
  .map((n) => ({ network: n, url: business.social[n] }))
  .filter((s): s is { network: typeof s.network; url: string } => s.url !== null);
---

<BaseLayout
  title="La carta"
  description={`Carta de ${business.shortName} en ${business.address.locality}: cafés, aromáticas, bebidas, tortas y postres. Mira los precios y pide en la barra.`}
  bodyClass="pb-20"
>
  <header class="bg-olive-900 text-cream-50">
    <div class="mx-auto flex max-w-2xl items-center gap-3 px-4 py-3">
      <a href="/" class="flex min-h-11 items-center gap-3 rounded-full" aria-label="Ir al inicio de Cántaro">
        <Logo size={44} class="ring-2 ring-cream-50/20" />
        <span class="leading-tight">
          <span class="block font-display text-xl font-semibold text-cream-50">Cántaro</span>
          <span class="block text-xs tracking-[0.18em] text-cream-100/80 uppercase">arte &amp; diseño</span>
        </span>
      </a>
    </div>
  </header>

  <main id="contenido">
    <div class="mx-auto max-w-2xl px-4 pt-6 pb-4">
      <h1 class="text-4xl font-semibold">La carta</h1>
      <p class="mt-1 text-bark-600">{business.tagline} · {business.address.locality}</p>
      {
        hasDemo && (
          <p class="mt-3 rounded-xl bg-clay-300/25 px-3 py-2 text-sm text-bark-800" role="note">
            Carta de ejemplo: productos y precios aún no son definitivos.
          </p>
        )
      }
    </div>

    <CategoryNav sections={sections} />

    <div class="mx-auto max-w-2xl space-y-10 px-4 pt-6 pb-10">
      {sections.map((s) => <CategorySection section={s} />)}
    </div>
  </main>

  <footer class="border-t border-bark-800/10 bg-cream-100">
    <div class="mx-auto max-w-2xl space-y-4 px-4 py-8 text-bark-800">
      <TodayHours />
      <nav aria-label="Enlaces" class="flex flex-wrap items-center gap-2">
        <a href="/" class="inline-flex min-h-11 items-center rounded-full px-3 font-medium underline-offset-4 hover:underline">
          Inicio
        </a>
        <a href="/contacto" class="inline-flex min-h-11 items-center rounded-full px-3 font-medium underline-offset-4 hover:underline">
          Contacto
        </a>
        <span class="flex-1"></span>
        {
          socials.map((s) => (
            <a
              href={s.url}
              target="_blank"
              rel="noopener"
              class="grid size-11 place-items-center rounded-full text-bark-800 hover:bg-cream-50"
              aria-label={`${business.shortName} en ${s.network[0]!.toUpperCase()}${s.network.slice(1)}`}
            >
              <SocialIcon network={s.network} />
            </a>
          ))
        }
      </nav>
      <p class="text-sm text-bark-600">Carta actualizada el {updatedAt}. Precios en pesos colombianos.</p>
    </div>
  </footer>

  <!-- Nota fija: el pedido se hace en persona. -->
  <div class="fixed inset-x-0 bottom-0 z-30 px-3 pb-[max(0.75rem,env(safe-area-inset-bottom))]" role="note">
    <p class="mx-auto w-fit max-w-full rounded-full bg-olive-900/95 px-4 py-2.5 text-center text-sm font-medium text-balance text-cream-50 shadow-lg backdrop-blur sm:px-5 sm:text-base">
      Haz tu pedido en la barra o con nuestro personal <span aria-hidden="true">🤎</span>
    </p>
  </div>
</BaseLayout>
