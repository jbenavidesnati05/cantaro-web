---
import PageLayout from '@/layouts/PageLayout.astro';
import PageHero from '@/components/layout/PageHero.astro';
import Icon from '@/components/brand/Icon.astro';
import { CRAFT_CATEGORIES, getCrafts } from '@/lib/catalog';
import { formatCOP } from '@/lib/format';
import { waLink } from '@/lib/whatsapp';
import { getAssetImage } from '@/lib/images';
import { Image } from 'astro:assets';
import bodegon from '@/assets/scenes/bodegon-artesanal.jpg';

const crafts = await getCrafts();
const groups = (
  await Promise.all(
    CRAFT_CATEGORIES.map(async (c) => ({ ...c, img: await getAssetImage(c.image), items: crafts.filter((i) => i.category === c.id) })),
  )
).filter((g) => g.items.length > 0);
const hasDemo = crafts.some((c) => c.demo);
const tones = ['bg-clay-500/12 text-clay-600', 'bg-leaf-500/15 text-olive-700', 'bg-clay-300/35 text-bark-800', 'bg-olive-900 text-cream-50', 'bg-cream-100 text-clay-600'];
---

<PageLayout
  title="Artesanías"
  description="Velas, esencias, textiles y cerámica hechos a mano en Cántaro, Sibundoy. Encuentra un detalle para tu casa o para regalar."
>
  <PageHero
    eyebrow="Tienda artesanal"
    title="Objetos hechos con las manos"
    highlight="las manos"
    intro="Velas, esencias, textiles y cerámica en pequeñas cantidades. Todas las piezas están en el local; pregúntanos por WhatsApp si quieres apartar una."
    image={bodegon}
    imageAlt="Bodegón con velas, cerámica pintada, esencias y macramé"
  >
    <nav aria-label="Categorías de artesanías" class="mt-8 flex flex-wrap gap-2">
      {
        groups.map((g) => (
          <a href={`#${g.id}`} class="inline-flex min-h-11 items-center gap-2 rounded-full bg-paper/80 px-4 font-medium ring-1 ring-bark-800/10 backdrop-blur transition hover:bg-paper">
            <Icon name={g.icon} size={18} class="text-clay-600" />
            {g.name}
          </a>
        ))
      }
    </nav>
  </PageHero>

  <div class="mx-auto max-w-6xl space-y-20 px-4 py-16 sm:px-6 sm:py-24">
    {
      hasDemo && (
        <p class="rounded-2xl bg-clay-300/25 px-4 py-3 text-bark-800" role="note">
          Catálogo de ejemplo: las piezas y precios reales se publicarán pronto.
        </p>
      )
    }

    {
      groups.map((g, gi) => (
        <section id={g.id} class="grid scroll-mt-28 gap-6 lg:grid-cols-[0.8fr_1.2fr] lg:gap-10" aria-labelledby={`${g.id}-t`}>
          {/* Imagen de la categoría (fija al hacer scroll en escritorio) */}
          <div class="lg:sticky lg:top-28 lg:self-start">
            <div class="reveal group relative flex aspect-[16/10] items-end overflow-hidden rounded-[2rem] bg-bark-800 lg:aspect-[4/5]">
              {g.img && (
                <span class="zoom-img absolute inset-0">
                  <Image src={g.img} alt="" widths={[400, 700]} sizes="(min-width: 1024px) 26rem, 100vw" class="size-full object-cover" />
                </span>
              )}
              <span class="absolute inset-0 bg-gradient-to-t from-[#2a1a0e]/90 via-[#2a1a0e]/20 to-transparent" aria-hidden="true" />
              <div class="relative p-6 text-cream-50">
                <span class="mb-3 grid size-11 place-items-center rounded-full bg-paper/20 backdrop-blur-md">
                  <Icon name={g.icon} size={22} />
                </span>
                <h2 id={`${g.id}-t`} class="text-4xl font-medium text-cream-50">{g.name}</h2>
                <p class="mt-1 text-cream-100/85">{g.blurb}</p>
              </div>
            </div>
          </div>

          <ul class="grid content-start gap-4 sm:grid-cols-2">
            {g.items.map((item) => {
              const price = formatCOP(item.priceCOP);
              const wa = waLink(`¡Hola, Cántaro! Me interesa "${item.name}". ¿Está disponible?`);
              return (
                <li class="reveal">
                  <article class="flex h-full flex-col rounded-[2rem] bg-paper p-6 shadow-[0_18px_40px_-30px_rgb(91_58_33/0.5)] ring-1 ring-bark-800/5">
                    {/* Sin fotos reales todavía: ícono de la categoría. Reemplazar por <Image> cuando existan. */}
                    <div class="flex items-start gap-4">
                      <span class:list={['grid size-14 shrink-0 place-items-center rounded-2xl', tones[gi % tones.length]]} aria-hidden="true">
                        <Icon name={g.icon} size={26} />
                      </span>
                      <div class="min-w-0">
                        {item.featured && (
                          <span class="mb-1 inline-block rounded-full bg-clay-500/12 px-2.5 py-0.5 text-xs font-semibold tracking-wide text-clay-600 uppercase">Favorito</span>
                        )}
                        <h3 class="text-2xl leading-tight font-medium">{item.name}</h3>
                      </div>
                    </div>
                    {item.description && <p class="mt-2 flex-1 text-bark-600">{item.description}</p>}
                    <div class="mt-5 flex items-center justify-between gap-3">
                      <p class:list={['font-semibold', price ? 'text-lg text-clay-600' : 'text-bark-600']}>
                        {price ?? 'Pregunta el precio'}
                      </p>
                      {!item.available && <span class="text-sm font-semibold text-bark-600">Agotado</span>}
                      {item.available && wa && (
                        <a
                          href={wa}
                          target="_blank"
                          rel="noopener"
                          class="inline-flex min-h-11 items-center gap-1.5 rounded-full px-4 text-sm font-semibold text-olive-900 ring-1 ring-olive-900/20 transition hover:bg-olive-900 hover:text-cream-50"
                          aria-label={`Preguntar por ${item.name} en WhatsApp`}
                        >
                          Preguntar
                          <Icon name="arrow-up-right" size={16} />
                        </a>
                      )}
                    </div>
                  </article>
                </li>
              );
            })}
          </ul>
        </section>
      ))
    }

    <section class="reveal grain relative overflow-hidden rounded-[2.5rem] bg-olive-900 p-8 text-cream-50 sm:p-14">
      <div class="blob pointer-events-none absolute -right-16 -bottom-20 size-64 bg-clay-500/25" aria-hidden="true"></div>
      <div class="relative max-w-xl">
        <span class="grid size-14 place-items-center rounded-2xl bg-white/10 text-clay-300"><Icon name="gift" size={28} /></span>
        <h2 class="mt-6 text-4xl font-medium text-cream-50">¿Buscas un regalo?</h2>
        <p class="mt-3 text-lg text-cream-100/85">
          Cuéntanos para quién es y armamos un detalle con piezas hechas a mano y empaque especial.
        </p>
        {
          waLink() && (
            <a
              href={waLink('¡Hola, Cántaro! Quiero armar un regalo.')}
              target="_blank"
              rel="noopener"
              class="mt-8 inline-flex min-h-12 items-center gap-2 rounded-full bg-clay-500 px-6 font-semibold text-cream-50 transition hover:bg-clay-600"
            >
              Armar mi regalo <Icon name="arrow-up-right" size={18} />
            </a>
          )
        }
      </div>
    </section>
  </div>
</PageLayout>
